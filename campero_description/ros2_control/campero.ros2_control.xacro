<?xml version="1.0"?>
<robot name="campero" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="campero_ros2_control" params="model mode prefix base_name">

    <xacro:include
      filename="$(find romea_mobile_base_description)/ros2_control/base4WD.ros2_control.xacro" />

    <xacro:property name="conf" value="$(find campero_description)/config/campero_${model}.yaml" />
    <xacro:include filename="$(find campero_description)/urdf/campero_properties.xacro" />

    <xacro:if value="${mode == 'simulation_gazebo'}">
      <xacro:property
        name="hardware_plugin"
        value="romea_mobile_base_gazebo/GazeboSystemInterface" />
    </xacro:if>

    <xacro:if value="${mode == 'simulation_gazebo_classic'}">
      <xacro:if value="${model == 'rubber'}">
        <xacro:property name="hardware_plugin"
          value="romea_mobile_base_gazebo/GazeboSystemInterface4WD" />
      </xacro:if>
      <xacro:if value="${model == 'mecanum'}">
        <xacro:property name="hardware_plugin"
          value="romea_mobile_base_gazebo/GazeboSystemInterface4WMD" />
      </xacro:if>
    </xacro:if>

    <xacro:if value="${'4dv' in mode or 'isaac' in mode}">
      <xacro:property
        name="hardware_plugin"
        value="romea_mobile_base_simulation/GenericSimulationSystemInterface" />
    </xacro:if>

    <xacro:if value="${mode ==  'live'}">
       <xacro:if value="${model == 'rubber'}">
        <xacro:property name="hardware_plugin"
          value="campero_hardware/CamperoHardware4WD" />
      </xacro:if>
       <xacro:if value="${model == 'mecanum'}">
        <xacro:property name="hardware_plugin"
          value="campero_hardware/CamperoHardware4WMD" />
      </xacro:if>
    </xacro:if>

    <xacro:base_control
      mode="${mode}"
      base_name="${base_name}"
      hardware_plugin="${hardware_plugin}" />

  </xacro:macro>

</robot>
